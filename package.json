{
  "name": "taskforge",
  "version": "1.0.0",
  "description": "TaskForge - Gestor de tareas para Windows",
  "main": "main.js",
  "author": "TaskForge",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.taskforge.app",
    "productName": "TaskForge",
    "directories": {
      "output": "release"
    },
    "files": [
      "**/*",
      "!release{,/**}"
    ],
    "win": {
      "icon": "icon.ico",
      "target": {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TaskForge",
      "artifactName": "TaskForge-Setup-${version}.exe"
    }
  }
}
